APP_NAME=RepayMaster API
APP_ENV=development
DEBUG=true
# Comma-separated list of exact front-end origins. "*" is permitted only while
# APP_ENV is NOT production -- under APP_ENV=production the app refuses to
# start with a wildcard, because wildcard origins plus credentials would trust
# every website to make credentialed cross-origin calls. Example for a real
# deployment:
#   APP_ENV=production
#   CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*

# Optional: only needed once the AI explanation endpoint is added (roadmap,
# not yet built).
GEMINI_API_KEY=

# Required -- the app now fails to start without this set (no insecure
# default is baked in). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ledger and payments (Phase 2/3)
# DATABASE_URL=sqlite:///./data/repaymaster_ledger.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/repaymaster
# PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Used by docker-compose.yml to start the postgres service. Use a URL-safe value.
# POSTGRES_PASSWORD=change-me
# Roles are granted in the database, not here. After migrating:
#   python -m app.cli grant-role <username> admin
