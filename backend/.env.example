APP_NAME=RepayMaster API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=*

# Optional: only needed once the AI explanation endpoint is added (roadmap,
# not yet built).
GEMINI_API_KEY=

# Required -- the app now fails to start without this set (no insecure
# default is baked in). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
