APP_NAME=RepayMaster API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=*

# Optional: only needed once the AI explanation endpoint is added (roadmap,
# not yet built).
GEMINI_API_KEY=

# JWT signing key for /auth and /history. The default in app/core/config.py
# is dev-only and INSECURE -- always set a real random value here before
# deploying anywhere reachable by anyone else.
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
