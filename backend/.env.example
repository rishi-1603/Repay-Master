APP_NAME=RepayMaster API
APP_ENV=development
DEBUG=true
# Comma-separated list of exact front-end origins. "*" is permitted only while
# APP_ENV is NOT production -- under APP_ENV=production the app refuses to
# start with a wildcard, because wildcard origins plus credentials would trust
# every website to make credentialed cross-origin calls. Example for a real
# deployment:
#   APP_ENV=production
#   CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*

# Optional: only needed once the AI explanation endpoint is added (roadmap,
# not yet built).
GEMINI_API_KEY=

# Required -- the app now fails to start without this set (no insecure
# default is baked in). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
